# Rebuildable from scripts, or too big for git
*.blend
*.blend1
experiments/*/output/*.exr
experiments/*/renders/
experiments/*/export/
experiments/*/exports/
experiments/*/reviews/crops_*/
experiments/*/reviews/*/crops_*/
experiments/*/reviews/sbs_*/
experiments/*/reviews/*/A.png
experiments/*/reviews/*/B.png
