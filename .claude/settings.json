{
  "permissions": {
    "allow": [
      "Bash(tools/blender.sh:*)",
      "Bash(BLEND=* tools/blender.sh:*)",
      "Bash(VERBOSE=1 tools/blender.sh:*)",
      "Bash(bash tools/:*)",
      "Bash(python3 tools/:*)"
    ],
    "deny": [
      "mcp__figma",
      "mcp__pencil",
      "mcp__playwright",
      "mcp__chrome-devtools",
      "mcp__claude-in-chrome",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Notion",
      "mcp__claude_ai_Slack",
      "mcp__claude_ai_Canva",
      "mcp__claude_ai_Granola",
      "mcp__claude_ai_Linear",
      "mcp__claude_ai_Spotify",
      "mcp__claude_ai_Wonder-circle"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "impeccable@impeccable": false,
    "paper-desktop@paper": false,
    "frontend-design@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "playwright@claude-plugins-official": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pipeline-reminder.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/research-gate.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/loop-guard.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/learnings-nudge.sh\""
          }
        ]
      }
    ]
  }
}
